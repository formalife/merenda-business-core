    } ]
  }, {
    "tStartMs": 571570,
    "dDurationMs": 8640,
    "segs": [ {
      "utf8": "Youtube è una sorgente straordinaria di traffico sia \nin organico che per farci delle sponsorizzate.  "
    } ]
  }, {
    "tStartMs": 580210,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Non da ultimo c'è anche Amazon in alcuni casi \ndove le persone è un motore di ricerca dove  "
    } ]
  }, {
    "tStartMs": 585070,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "le persone vanno a cercare non informazioni ma \nvogliono comprare direttamente ok? E' straordinario  "
    } ]
  }, {
    "tStartMs": 590200,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Quindi se ne abbiamo dei prodotti dei servizi \nche possono avere delle correlazioni con quello  "
    } ]
  }, {
    "tStartMs": 593800,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "che si vende su amazon o per esempio nella sezione \nlibri quindi non sono i prodotti ma sono dei libri  "
    } ]
  }, {
    "tStartMs": 598480,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "che parlano del nostro servizio eventualmente io \nposso comparire e comprare le mie sponsorizzate lì  "
    } ]
  }, {
    "tStartMs": 603850,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "Quindi questa è la mia prima scelta nel digital \nmarketing in ordine: Google, Youtube, Amazon! Poi  "
    } ]
  }, {
    "tStartMs": 609370,
    "dDurationMs": 6630,
    "segs": [ {
      "utf8": "uso i social sicuramente per fare retargeting \nquindi per ricomparire davanti a queste persone  "
    } ]
  }, {
    "tStartMs": 616000,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "insieme ai vari circuiti come google display per \nesempio ok quindi ho la possibilità di ricomparire  "
    } ]
  }, {
    "tStartMs": 621330,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "inseguire con l'effetto padella di amazon le \npersone. Questo è il vero digital marketing!  "
    } ]
  }, {
    "tStartMs": 627210,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "Ma riassumendo cosa che devo fare allora? Se \nsono b2b parto con la carta e poi vado con  "
    } ]
  }, {
    "tStartMs": 632580,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "le ricerche su google e youtube amazon eccetera \neccetera le metto insieme trovi migliori clienti  "
    } ]
  }, {
    "tStartMs": 637830,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "e poi inseguo questi clienti possibilmente con \nil retargeting anche sui social ma come ultima  "
    } ]
  }, {
    "tStartMs": 643260,
    "dDurationMs": 5610,
    "segs": [ {
      "utf8": "scelta. Nel b2c si parto invece da google \nyoutube amazon eccetera eccetera cerco di  "
    } ]
  }, {
    "tStartMs": 648870,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "farmi dare i dati di contatto perché io voglio \nstringere il cliente in una morsa a tenaglia  "
    } ]
  }, {
    "tStartMs": 652650,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "cioè voglio potergli inviare dei materiali cartacei \nquindi voglio poter rimandare dei materiali fisici  "
    } ]
  }, {
    "tStartMs": 659370,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "voglio portarlo fuori dal web perché nel web ci \nsono i pericoli ci sono i concorrenti ci sono  "
    } ]
  }, {
    "tStartMs": 663330,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "le distrazioni quindi quando invece io posso \nmandarti della roba o posso raggiungerlo per  "
    } ]
  }, {
    "tStartMs": 667710,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "telefono ho raggiunto il mio scopo quindi raccolgo \ni dati di contatto il cliente gli mando della roba  "
    } ]
  }, {
    "tStartMs": 672810,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "fisica e lo faccio contattare da un venditore. \nQuindi non esiste per riassume ragazzi solo il  "
    } ]
  }, {
    "tStartMs": 677220,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "concetto di digital esiste certamente il mondo \ndigitale ma è uno strumento io voglio portare  "
    } ]
  }, {
    "tStartMs": 681330,
    "dDurationMs": 6450,
    "segs": [ {
      "utf8": "le persone lontane il più velocemente possibile \nok dal mondo digitale e voglio portare nel mondo  "
    } ]
  }, {
    "tStartMs": 687780,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "fisico dove possa interagire con loro e dove \nnon ci sono i concorrenti ok? Quindi ci sono i  "
    } ]
  }, {
    "tStartMs": 691950,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "miei materiali fisici dentro i miei materiali \nfisici nei miei pacchi nei mie lettere qui non  "
    } ]
  }, {
    "tStartMs": 695640,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "compaiono dei pop up della concorrenza ok e \nin più voglio portarle a dialogare con un mio  "
    } ]
  }, {
    "tStartMs": 700770,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "venditore che fissi magari un appuntamento dal \nvivo io da loro loro da me è via teleconferenza  "
    } ]
  }, {
    "tStartMs": 704940,
    "dDurationMs": 5370,
    "segs": [ {
      "utf8": "al telefono stesso eccetera eccetera eccetera \nQuindi questa è tutta la realtà sul Digital  "
    } ]
  }, {
    "tStartMs": 710310,
    "dDurationMs": 5790,
    "segs": [ {
      "utf8": "Marketing se vuoi saperne di più continua a \nseguire il canale mi raccomando iscriviti ok  "
    } ]
  }, {
    "tStartMs": 716100,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "clicca sulla campanellina degli avvisi metti \nun like e ci vediamo la prossima volta ciao"
