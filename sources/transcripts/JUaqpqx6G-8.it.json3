    "segs": [ {
      "utf8": "in bisogno di scambiare, in termini di\nreciprocità del blog chiaramente"
    } ]
  }, {
    "tStartMs": 191360,
    "dDurationMs": 3599,
    "segs": [ {
      "utf8": "perché do delle informazioni, se i miei\narticoli sono utili per le persone"
