  }, {
    "tStartMs": 157280,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "non è vero ma comunque una trattativa,"
    } ]
  }, {
    "tStartMs": 159000,
    "dDurationMs": 6020,
    "segs": [ {
      "utf8": "sono andato lì a chiudere un contratto\npossibilmente, non ho scambiato prima"
    } ]
  }, {
    "tStartMs": 165020,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "con questa persona, non ho dato, non ho\ncondiviso, non ho offerto, non ho regalato"
