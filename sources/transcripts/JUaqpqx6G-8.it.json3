  }, {
    "tStartMs": 170540,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "non ho ... e questa cosa è molto importante\ninvece molto importante stimolarla in"
    } ]
  }, {
    "tStartMs": 175250,
    "dDurationMs": 5590,
    "segs": [ {
      "utf8": "maniera estremamente forte. Quali sono\ngli strumenti che posso usare"
