  "events": [ {
    "tStartMs": 13040,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "Altro passaggio: bisogno di reciprocità. Esiste, per esempio, la regola"
    } ]
  }, {
    "tStartMs": 18680,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "della reciprocità di Cialdini, ne parla nei suoi libri costantemente la regola"
    } ]
  }, {
    "tStartMs": 24120,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "della reciprocità e noi la applichiamo\ncertamente perché una regola vera"
    } ]
  }, {
    "tStartMs": 29789,
    "dDurationMs": 6661,
    "segs": [ {
      "utf8": "e voglio insegnarvi come si usa, in termini\ndi marketing spicciolo, per come lo"
    } ]
  }, {
    "tStartMs": 36450,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "facciamo noi quindi non solo il concetto\nteorico ma proprio come applicarlo molto"
    } ]
  }, {
    "tStartMs": 40980,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "velocemente\nallora il bisogno di reciprocità"
    } ]
  }, {
    "tStartMs": 45390,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "si basa su questo c'è il bisogno di\nsdebitarsi o restituire almeno in parte"
    } ]
  }, {
    "tStartMs": 50250,
    "dDurationMs": 4559,
    "segs": [ {
      "utf8": "ciò che ci è stato donato; è un hacking\nmentale molto forte soprattutto nei"
    } ]
  }, {
    "tStartMs": 54809,
    "dDurationMs": 4531,
    "segs": [ {
      "utf8": "confronti della concorrenza. Per esempio, stamattina guardavamo il funnel"
    } ]
  }, {
    "tStartMs": 59340,
    "dDurationMs": 5639,
    "segs": [ {
      "utf8": "che vi ho mostrato: lì io parto che\nsto regalando un libro a una persona,"
    } ]
  }, {
    "tStartMs": 64979,
    "dDurationMs": 3721,
    "segs": [ {
      "utf8": "gli regalo un meeting o un webinar comunque con tante informazioni sessione"
    } ]
  }, {
    "tStartMs": 68700,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "di domande e risposte, sono già tre passi avanti\n in ciò che gli ho donato"
    } ]
  }, {
    "tStartMs": 73710,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "rispetto a quello che fa qualunque\nconcorrente, è già tanta roba"
    } ]
  }, {
    "tStartMs": 78820,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "mi trovo dentro anche un cavallo di\nTroia che è quello della reciprocità"
    } ]
  }, {
    "tStartMs": 82650,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "in maniera molto forte, ti regalo comunque\nun libro e ti regalo un meeting, ti regalo"
    } ]
  }, {
    "tStartMs": 87720,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "un evento, ti regalo un webinar e dopo ti\nregalo una consulenza qualunque altra"
    } ]
  }, {
    "tStartMs": 92640,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "cosa di bonus vogliamo metterci in coda,\nva benissimo, mette la persona"
    } ]
  }, {
    "tStartMs": 95670,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "direttamente fuori scambio tra\nvirgolette rispetto a coloro che si"
    } ]
  }, {
    "tStartMs": 99270,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "presentano lì bussando alla porta o vendere\na freddo strappando un appuntamento"
    } ]
  }, {
    "tStartMs": 104500,
    "dDurationMs": 4759,
    "segs": [ {
      "utf8": "facendo spam di mail, di fax, è chiaro che\ncambia, io semplicemente in termini"
    } ]
  }, {
    "tStartMs": 109259,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "di immagine, di approccio, cambia tutto\ncambia tutto perché con uno mi sento"
