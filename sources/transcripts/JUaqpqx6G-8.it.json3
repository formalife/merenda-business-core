  }, {
    "tStartMs": 112979,
    "dDurationMs": 3691,
    "segs": [ {
      "utf8": "quasi in debito o se non mi sento in\ndebito con l'altro lo percepisco come"
    } ]
  }, {
    "tStartMs": 116670,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "uno che mi viene a rompere i *******.\nGià in termini di partenza è diverso"
    } ]
  }, {
    "tStartMs": 121560,
    "dDurationMs": 4769,
    "segs": [ {
      "utf8": "è completamente differente\nil gioco che andiamo a fare quindi"
    } ]
  }, {
    "tStartMs": 126329,
    "dDurationMs": 4281,
    "segs": [ {
      "utf8": "il segreto, ragazzi, è fornire il più\npossibile al cliente attenzioni"
