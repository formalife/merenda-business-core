{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1620,
    "dDurationMs": 7300,
    "segs": [ {
      "utf8": "Come funziona la prova attraverso macchinario, \ntest, sistema e attrezzatura in genere."
    } ]
  }, {
    "tStartMs": 9180,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "E' una prova estremamente importante,\nche ognuno di noi dovrebbe riuscire in qualche modo,"
    } ]
  }, {
    "tStartMs": 13700,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "vi consiglio \ncaldamente di implementare"
    } ]
  }, {
    "tStartMs": 15780,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "nella maniera migliore che riuscite\nall'interno della vostra azienda,"
    } ]
  }, {
    "tStartMs": 20940,
    "dDurationMs": 6280,
    "segs": [ {
      "utf8": "perché per dare prova di quello di ciò\nche facciamo, un conto è \"lo dico io\","
    } ]
  }, {
    "tStartMs": 27220,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "un conto è \"lo dice un cliente soddisfatto\" \nche certamente è qualcosa di importante,"
    } ]
  }, {
    "tStartMs": 33080,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "un conto è \"lo dice l'esame\",\nun conto è \"lo dice il computer\","
    } ]
  }, {
    "tStartMs": 39090,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "un conto è \"lo dice il test\", un conto è lo dice il\nrisultato di questa prova"
    } ]
  }, {
    "tStartMs": 43890,
    "dDurationMs": 5050,
    "segs": [ {
      "utf8": "un conto è il risultato di questo macchinario, \nquindi quello che io devo fare"
    } ]
  }, {
    "tStartMs": 48940,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "è creare una prova, un test, un macchinario, \na seconda di quello che è il mio settore,"
    } ]
  }, {
    "tStartMs": 53860,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "di quello che faccio, per evitare\ndi fare in modo che il mio consiglio"
    } ]
  }, {
    "tStartMs": 59220,
    "dDurationMs": 6299,
    "segs": [ {
      "utf8": "nasca e sia percepito solo come qualcosa che\nnasca da una mia opinione, quindi"
    } ]
  }, {
    "tStartMs": 65520,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "finché è la mia opinione allora dopo è un problema di brand, di convincimento, la mia opinione"
    } ]
  }, {
    "tStartMs": 68940,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "contro quella di un concorrente. Nel\nmomento in cui lo dice il software,"
    } ]
  }, {
    "tStartMs": 73800,
    "dDurationMs": 6750,
    "segs": [ {
      "utf8": "lo dice il sistema, lo dice l'analisi, è\nun cambio molto forte in termini"
    } ]
  }, {
    "tStartMs": 80550,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "di percezione e di autorità, quindi le\npersone le spingo a decidere in una maniera"
    } ]
  }, {
    "tStartMs": 85320,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "molto, molto più forte;\nquindi quello che devo fare"
    } ]
  }, {
    "tStartMs": 88320,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "è riuscire a dire, lo dice il computer, \nnel senso lo dice il software"
    } ]
  }, {
    "tStartMs": 92720,
    "dDurationMs": 7100,
    "segs": [ {
      "utf8": "lo dice il macchinario, lo dice il test,\nlo dicono le prove di laboratorio,"
    } ]
  }, {
    "tStartMs": 100720,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "lo dice il tampone, eccetera.\nLo dice qualunque cosa"
    } ]
  }, {
    "tStartMs": 105980,
    "dDurationMs": 5139,
    "segs": [ {
      "utf8": "possa essere percepito come una\nprova scientifica, anche se non lo è."
    } ]
  }, {
    "tStartMs": 111120,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "L'importante è che possa sembrarlo, deve\nsembrare una cosa terza, rispetto a me"
    } ]
  }, {
    "tStartMs": 117840,
    "dDurationMs": 5279,
    "segs": [ {
      "utf8": "quindi devo creare una dimostrazione\nlegata a qualche accessorio, sistema"
    } ]
  }, {
    "tStartMs": 123119,
    "dDurationMs": 4591,
    "segs": [ {
      "utf8": "analisi, test, tampone che non sia\nqualcosa di creata appositamente da me,"
    } ]
  }, {
    "tStartMs": 127710,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "ma che produce magari qualcun altro \ne che io posso utilizzare"
    } ]
  }, {
    "tStartMs": 131610,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "per confermare, in realtà, la bontà \ndel mio approccio, della mia diagnosi"
    } ]
  }, {
    "tStartMs": 135580,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "della necessità del mio prodotto,\ndella necessità del mio servizio,"
    } ]
  }, {
    "tStartMs": 138920,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "del mio modo di fare le cose. Ad esempio, io faccio\nil parrucchiere o vendo prodotti per parrucchieri"
    } ]
  }, {
    "tStartMs": 145160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "o faccio il parrucchiere e \nvoglio vendere prodotti, per esempio, ai clienti"
    } ]
  }, {
    "tStartMs": 148800,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "e i parrucchieri sono tendenzialmente\nmolto scarsi in questa attività,"
    } ]
  }, {
    "tStartMs": 152180,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "per esempio di up selling, di\nprodotti vari o di far scegliere prima"
    } ]
  }, {
    "tStartMs": 155740,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "il tipo di trattamento, vedono il cliente \"cosa\nvoleva fare?\" e poi chiedono"
    } ]
  }, {
    "tStartMs": 159520,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "e cominciano a mettere le mani, le forbici,\ni colori, fanno quelle cose lì."
    } ]
  }, {
    "tStartMs": 164220,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "E' diverso quando, per esempio, il cliente\nviene messo davanti a un macchinario"
    } ]
  }, {
    "tStartMs": 170680,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "che gli mostra e lui può vedere. \nLa prova, per esempio, del cuoio capelluto"
    } ]
  }, {
    "tStartMs": 176240,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "l'analisi del capello, \nl'analisi del cuoio capelluto"
    } ]
  }, {
    "tStartMs": 179260,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "e quindi io, in questo caso,\nmostro al cliente:"
    } ]
  }, {
    "tStartMs": 183240,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "\"Guarda, il macchinario ci mostra che il\ntuo capello è così, il cuoio capelluto è così"
    } ]
  }, {
    "tStartMs": 188180,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "è necessario questo, è necessario\nquest'altro, quindi prima di proporre,"
    } ]
  }, {
    "tStartMs": 192900,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "c'è una diagnosi a monte, che viene\nfatta attraverso un sistema di test,"
    } ]
  }, {
    "tStartMs": 197060,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "cioè lo dice il test che tu hai bisogno di\nfare questo trattamento ristrutturante,"
    } ]
  }, {
    "tStartMs": 202080,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "non è uno che ti ha fatto un taglio e\npoi ti dice \"guarda ho visto i capelli"
    } ]
  }, {
    "tStartMs": 204920,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "un po' sfibrati, secondo me ti serve anche\nil ristrutturante\", perché fanno così,"
    } ]
  }, {
    "tStartMs": 210420,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "\"tesoro hai i capelli che sono un po' sfribrati, \nvedo un po' di doppie punte,"
    } ]
  }, {
    "tStartMs": 213740,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "te le abbiamo tolte, ma ti serve un po'\ndi ristrutturante\". Un conto è farlo così"
    } ]
  }, {
    "tStartMs": 218380,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "e quindi se mi fido, va bene; un conto è\nvedo i capelli che sono rotti e sono"
    } ]
  }, {
    "tStartMs": 222500,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "da ristrutturare e quindi automaticamente\nlo dice il test, lo dice l'immagine,"
    } ]
  }, {
    "tStartMs": 227380,
    "dDurationMs": 7940,
    "segs": [ {
      "utf8": "e lo mostro, e lo faccio vedere\nalle persone, in questo modo."
    } ]
  } ]
}
