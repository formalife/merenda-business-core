{
  "wireMagic": "pb3",
  "pens": [ {

  } ],
  "wsWinStyles": [ {

  } ],
  "wpWinPositions": [ {

  } ],
  "events": [ {
    "tStartMs": 940,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "Un'altra cosa che le persone adorano, \nè il concetto di plug and play."
    } ]
  }, {
    "tStartMs": 6220,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Plug and play è attacchi e va. \nAttacchi e giochi, sarebbe come una console,"
    } ]
  }, {
    "tStartMs": 10900,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "ed è per questo che le console sono andate alla\ngrandissima, da quando sono nate,"
    } ]
  }, {
    "tStartMs": 15540,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "perchè a differenza dei PC, dove per far partire i giochi dovevi essere"
    } ]
  }, {
    "tStartMs": 22580,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "all'inizio degli anni '90 un programmatore, dovevi scrivere righe su righe"
    } ]
  }, {
    "tStartMs": 25760,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "solo per dargli il caricamento,\nalmeno nel Commodore 64"
    } ]
  }, {
    "tStartMs": 29320,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "era \"load\" e poi andavano, era facile, \ncon la cassettina ed era meraviglioso,"
    } ]
  }, {
    "tStartMs": 33699,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "c'era il contagiri, però se avevi\ngià i primi Penthium,"
    } ]
  }, {
    "tStartMs": 37329,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "facevi girare i primi giochini, lì era un casino, \ndovevi proprio sapere dove mettere le mani"
    } ]
  }, {
    "tStartMs": 40899,
    "dDurationMs": 3151,
    "segs": [ {
      "utf8": "quindi, ovviamente, c'erano il NES,\nle prime console, tu attaccavi"
    } ]
  }, {
    "tStartMs": 44050,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "e giocavi a Super Mario, ma questo è giusto,"
    } ]
  }, {
    "tStartMs": 47420,
    "dDurationMs": 4459,
    "segs": [ {
      "utf8": "è quello che vuole la gente, quindi,\nle console lavorano sul concetto"
    } ]
  }, {
    "tStartMs": 51880,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "plug and play, cioè attacco e va, \nattacco e deve andare."
    } ]
  }, {
    "tStartMs": 54700,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Qualunque cosa che richieda una\nprogrammazione o qualunque tipo"
    } ]
  }, {
    "tStartMs": 58960,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "di sforzo, è difficile, per esempio abbiamo\nSteve della Wildix"
    } ]
  }, {
    "tStartMs": 63500,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "loro hanno un sistema di comunicazione integrata per\nl'azienda, che è veramente meraviglioso,"
    } ]
  }, {
    "tStartMs": 67000,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "perché hanno una qualità audio/video\naltissima, molto superiore, per esempio,"
    } ]
  }, {
    "tStartMs": 70960,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "a Skype, Google Hangouts, molto superiore \ncioè si vede veramente molto bene,"
    } ]
  }, {
    "tStartMs": 74380,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "si sente benissimo, ha delle funzionalità\nfantastiche, ma al di là di questo non è"
    } ]
  }, {
    "tStartMs": 78370,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "\"è meglio il prodotto\". Una cosa fantastica, \nper esempio, voi dovete fare"
    } ]
  }, {
    "tStartMs": 81720,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "una videoconferenza, la dovete fare con\nSkype, avete un cliente"
    } ]
  }, {
    "tStartMs": 84600,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "solo che per far partire Skype, lo devi\nprendere, lo devi trovare, lo devi scaricare"
    } ]
  }, {
    "tStartMs": 87780,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "il tipo deve fare doppio clic, lo deve\ninstallare, il 99% degli italiani"
    } ]
  }, {
    "tStartMs": 91140,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "non è in grado cioè in Italia non riesci\na fare le videoconferenze"
    } ]
  }, {
    "tStartMs": 94200,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "con le persone perché le persone \nnon riescono a installare Skype ."
    } ]
  }, {
    "tStartMs": 97680,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Il 70% di questa sala, non riusciva a mettere \nla password nell'area riservata"
    } ]
  }, {
    "tStartMs": 102440,
    "dDurationMs": 6720,
    "segs": [ {
      "utf8": "perché sbagliava a copiare e ad incollare,\nsono arrivate 450 email di assistenza"
    } ]
  }, {
    "tStartMs": 109160,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "\"non riesco ad accedere all'area riservata\"."
    } ]
  }, {
    "tStartMs": 111940,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "Perché non riesci a fare copia e incolla,\nperché c'erano dei caratteri che non piacevano"
    } ]
  }, {
    "tStartMs": 116480,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "e qualcuno li toglieva \n\"no, ma questo mi sono un carattere strano,"
    } ]
  }, {
    "tStartMs": 118980,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "secondo me non fa parte della password\". \nMa lasciala così com'è,"
    } ]
  }, {
    "tStartMs": 122800,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "ora vuole inventare lui la password.\nA parte le battute, quindi è qualcosa"
    } ]
  }, {
    "tStartMs": 126220,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "di molto complicato e per,\nesempio, Wildix ti manda il link,"
    } ]
  }, {
    "tStartMs": 129420,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "tu ci clicchi sopra, si apre nel browser\ndirettamente e sei immediatamente plug and play,"
    } ]
  }, {
    "tStartMs": 133560,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "in videoconferenza, ed è straordinario, \nquindi al di là della qualità molto alta,"
    } ]
  }, {
    "tStartMs": 137960,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "funziona e quindi è un prodotto \nche è nato, progettato"
    } ]
  }, {
    "tStartMs": 141740,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "per risolvere tutta una serie \ndi problemi che invece il leader"
    } ]
  }, {
    "tStartMs": 144170,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "di mercato, le applicazioni più\nutilizzate, solitamente non risolvono"
    } ]
  }, {
    "tStartMs": 148970,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "cioè che semplicemente quelli di Skype\nnon avevano pensato che le persone"
    } ]
  }, {
    "tStartMs": 153560,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "non riescono a scaricare un\nprogramma, installarlo, e farlo funzionare."
    } ]
  }, {
    "tStartMs": 157120,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Non è user friendly, per le persone fare una operazione del genere,"
    } ]
  }, {
    "tStartMs": 159740,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "è come programmare un reattore nucleare."
    } ]
  } ]
}
