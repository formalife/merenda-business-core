    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "Frank Merenda è l'uomo che ha stabilito un \nrecord dopo l'altro nella formazione per  "
    } ]
  }, {
    "tStartMs": 16100,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "imprenditori. Autore di best seller come \"vendere \nfa schifo se non sai come farlo\", \"le sette leggi  "
    } ]
  }, {
    "tStartMs": 22400,
    "dDurationMs": 7770,
    "segs": [ {
      "utf8": "del marketing per il xxi secolo\" e \"50 colpi \ndi Frank\"; creatore del \"Merenda Montly\" l'unico  "
    } ]
  }, {
    "tStartMs": 30170,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "mensile dedicato agli imprenditori. Migliaia e \nmigliaia di imprenditori frequentano ogni anno  "
    } ]
  }, {
    "tStartMs": 36740,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "i suoi corsi rendendolo a tutti gli effetti \nuno dei più seguiti e pagati formatori in  "
    } ]
  }, {
    "tStartMs": 42200,
    "dDurationMs": 6270,
    "segs": [ {
      "utf8": "tutto il mondo. Ha testato le sue conoscenze in \ncentinaia di settori e con migliaia di aziende;  "
    } ]
  }, {
    "tStartMs": 48470,
    "dDurationMs": 7170,
    "segs": [ {
      "utf8": "ha lavorato fianco a fianco con diverse leggende \ndel marketing mondiale; ha letteralmente cambiato  "
    } ]
  }, {
    "tStartMs": 55640,
    "dDurationMs": 7260,
    "segs": [ {
      "utf8": "il tessuto imprenditoriale portando nelle \nsue aule imprenditori da tutto il mondo. È  "
    } ]
  }, {
    "tStartMs": 62900,
    "dDurationMs": 8430,
    "segs": [ {
      "utf8": "arrivato a riempire un palazzetto dello sport \ncon 5.136 persone pronte a studiare e cambiare  "
    } ]
  }, {
    "tStartMs": 71330,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "le loro attività; ha costruito in svizzera il \nprimo e unico centro studi per imprenditori in  "
    } ]
  }, {
    "tStartMs": 77330,
    "dDurationMs": 7140,
    "segs": [ {
      "utf8": "Europa. Tutto questo è Frank Merenda e in questo \ncanale youtube hai la possibilità di seguire  "
    } ]
  }, {
    "tStartMs": 84470,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "in modo completamente gratuito le sue lezioni. \nISCRIVITI ORA per non perdere nemmeno un video!"
