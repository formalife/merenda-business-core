{
  "wireMagic": "pb3",
  "pens": [ {

  } ],
  "wsWinStyles": [ {

  } ],
  "wpWinPositions": [ {

  } ],
  "events": [ {
    "tStartMs": 12880,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Ma esiste già un paccone che vende la nostra pubblicità."
    } ]
  }, {
    "tStartMs": 15900,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "Se noi siamo bravi e fate quello che vi\nho detto oggi, qual è? Il libro!"
    } ]
  }, {
    "tStartMs": 20840,
    "dDurationMs": 7560,
    "segs": [ {
      "utf8": "Il libro è una sales letter lunga, non è manualistica. Il libro è una lettera di vendita,"
    } ]
  }, {
    "tStartMs": 28720,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "che in vendita, se lo volete mettere in vendita, la gente"
    } ]
  }, {
    "tStartMs": 30980,
    "dDurationMs": 4079,
    "segs": [ {
      "utf8": "può comprare, ma di base noi lo possiamo anche regalare perché ha"
    } ]
  }, {
    "tStartMs": 35060,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "la forma di un libro, crea un certo livello di autorità nei confronti delle persone"
    } ]
  }, {
    "tStartMs": 40280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "ma bisogna dire le cose come\nsono"
    } ]
  }, {
    "tStartMs": 41960,
    "dDurationMs": 6300,
    "segs": [ {
      "utf8": "il libro è una sales letter, non è un libro, non è narrativa, non è un saggio,"
    } ]
  }, {
    "tStartMs": 48260,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "non è un libro realmente; certo che c'è del\ncontenuto ma c'è tutto quel contenuto"
    } ]
  }, {
    "tStartMs": 53540,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "che serve per far passare la sales letter inosservata, ma è una lettera di vendita"
    } ]
  }, {
    "tStartMs": 59440,
    "dDurationMs": 6980,
    "segs": [ {
      "utf8": "stampata sotto forma di libro. E' convincere le persone a leggersi 160-200-300 pagine"
    } ]
  }, {
    "tStartMs": 66500,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "di mia lettera di vendita. Quello è un libro. E' una lettera di vendita lunga,"
    } ]
  }, {
    "tStartMs": 73640,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "però se io lo regalo alle persone, un libro è qualcosa di prezioso."
    } ]
  }, {
    "tStartMs": 77300,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Una lettera di vendita si butta via, il libro non si butta via."
    } ]
  }, {
    "tStartMs": 81200,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "Tutti i materiali di marketing fisici, i libri, i pacconi dm, hanno un grande vantaggio"
    } ]
  }, {
    "tStartMs": 86860,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "rispetto ai materiali di marketing online, per esempio, perché"
    } ]
  }, {
    "tStartMs": 89600,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "hanno una caratteristica che posseggono solo loro, si chiama"
    } ]
  }, {
    "tStartMs": 94480,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "\"invadere l'ambiente\". \nPer esempio, il libro nessuno lo butta, lo mettono in libreria"
    } ]
  }, {
    "tStartMs": 99140,
    "dDurationMs": 4979,
    "segs": [ {
      "utf8": "o lo tengono appoggiato sulla scrivania e\nil giorno che ovviamente questa persona"
    } ]
  }, {
    "tStartMs": 104119,
    "dDurationMs": 2791,
    "segs": [ {
      "utf8": "avrà bisogno di cambiare fornitore o sta\nvalutando effettivamente di fare"
    } ]
  }, {
    "tStartMs": 106910,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "un acquisto, se il mio libro è nella sua scrivania"
    } ]
  }, {
    "tStartMs": 108960,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "o sulla sua libreria, ovviamente, io ci sono."
    } ]
  }, {
    "tStartMs": 112420,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "Il mio paccone non viene buttato via. Io ho quelli che i miei studenti mi mandano, ce li ho negli scaffali,"
    } ]
  }, {
    "tStartMs": 117920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "sono belli, bellissimi, queste scatole, ce li ho lì, me li guardo sempre."
    } ]
  }, {
    "tStartMs": 121600,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "E se io fossi un cliente, nel senso che mi sono arrivati per..., il giorno che sono motivato a"
    } ]
  }, {
    "tStartMs": 125840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "anche se magari non ho deciso in quel momento, parto."
    } ]
  }, {
    "tStartMs": 130780,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Per esempio, in Posta Power, abbiamo cominciato a stampare"
    } ]
  }, {
    "tStartMs": 133100,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "le newsletter e sono così belle che la gente cominciano ad arrivargli"
    } ]
  }, {
    "tStartMs": 135980,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "ci chiede gli arretrati come se fosse una rivista \" a me avete"
    } ]
  }, {
    "tStartMs": 139580,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "cominciato a mandarmela dal numero 12, possa avere quelle prima?\""
    } ]
  }, {
    "tStartMs": 142380,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "No, le abbiamo buttate, non le abbiamo"
    } ]
  }, {
    "tStartMs": 147280,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "non è un magazine ma la gente invece essendo così tante"
    } ]
  }, {
    "tStartMs": 150209,
    "dDurationMs": 4411,
    "segs": [ {
      "utf8": "informazioni perché ha la forma di un\nmagazine, vuole gli arretrati"
    } ]
  }, {
    "tStartMs": 154620,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "\"mi mandate gli arretrati? Non so se ce li abbiamo, chiedo. Non lo so.\""
    } ]
  }, {
    "tStartMs": 160680,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Perché la newsletter è percepita come una rivista, come un magazine,"
    } ]
  }, {
    "tStartMs": 163500,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "non viene buttata via quindi un'email, un pdf, viene cancellato"
    } ]
  }, {
    "tStartMs": 168700,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "è in un luogo non esistente all'interno di un file, all'interno del vostro pc,"
    } ]
  }, {
    "tStartMs": 172900,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "del vostro Mac e non esiste. \nLa roba stampata, la roba di carta"
    } ]
  }, {
    "tStartMs": 177060,
    "dDurationMs": 6270,
    "segs": [ {
      "utf8": "ha un valore enorme in termini di marketing. \nPerché, secondo voi, io non"
    } ]
  }, {
    "tStartMs": 183330,
    "dDurationMs": 6170,
    "segs": [ {
      "utf8": "vi do la roba in pdf ma vi mando via con otto chili di roba, vi do quei dvd"
    } ]
  }, {
    "tStartMs": 189500,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "quando vi potrei mandare il file come fanno tutti online, ve lo scaricate con"
    } ]
  }, {
    "tStartMs": 192930,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "dropbox. Perchè? \nPerchè vi devo perseguitare. In casa dovete avere"
    } ]
  }, {
    "tStartMs": 198030,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "quella roba, nella vostra libreria, nella vostra camera, sulla vostra"
    } ]
  }, {
    "tStartMs": 201420,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "scrivania, ci deve essere scritto Frank Merenda ovunque, anche sulla carta del bagno"
    } ]
  }, {
    "tStartMs": 205420,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "non mi interessa, non sono permaloso. Pulitevi il sedere con la mia faccia"
    } ]
  }, {
    "tStartMs": 209760,
    "dDurationMs": 5699,
    "segs": [ {
      "utf8": "basta che io sia ovunque, e voi dovete fare uguale."
    } ]
  }, {
    "tStartMs": 215460,
    "dDurationMs": 7760,
    "segs": [ {
      "utf8": "Dobbiamo invadere l'ambiente.\n\"Il futuro è il web, è l'on-line ...\". Il futuro non è lì."
    } ]
  }, {
    "tStartMs": 223220,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "Il futuro nella roba fisica, che si tocca. \nSapete come sopravvivono tutte"
    } ]
  }, {
    "tStartMs": 228540,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "le industrie che sono distrutte la musica,  il blu ray nel senso i film,"
    } ]
  }, {
    "tStartMs": 234360,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "come vivono? Vivono tutte con la roba fisica. Che cos'è che si compra"
    } ]
  }, {
    "tStartMs": 238470,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "la gente? Solo quelle collector box, \ncollector edition, con dentro"
    } ]
  }, {
    "tStartMs": 243120,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "la statuetta, con dentro la sciarpina, con dentro il cazzillo."
    } ]
  }, {
    "tStartMs": 247580,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "L'edizione speciale che è diversa, è superiore rispetto alla versione standard con della roba"
    } ]
  }, {
    "tStartMs": 252510,
    "dDurationMs": 4319,
    "segs": [ {
      "utf8": "in più la statuetta, l'action figure e la gente la vuole in casa,"
    } ]
  }, {
    "tStartMs": 256829,
    "dDurationMs": 4561,
    "segs": [ {
      "utf8": "la vuole esporre. Non si combatte la\npirateria con i cd, è chiaro che sono"
    } ]
  }, {
    "tStartMs": 261390,
    "dDurationMs": 5450,
    "segs": [ {
      "utf8": "morti i cd, i dvd normali e quindi tu non devi vendere cd e dvd normali"
    } ]
  }, {
    "tStartMs": 266840,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "devi invadere l'ambiente con delle cose che le persone abbiano voglia di esporre"
    } ]
  }, {
    "tStartMs": 272680,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "abbiano voglia di tenerle lì, le collector\nbox, le collector edition"
    } ]
  }, {
    "tStartMs": 277580,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "quindi come faccio la musica, devi fare roba fisica bella, da tenere"
    } ]
  }, {
    "tStartMs": 280720,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "in casa, se vuoi vendere quella cosa lì, se no la regali come file e va bene."
    } ]
  }, {
    "tStartMs": 284760,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "Regali la versione base, vendi la versione giocattolosa. Questo è quello che devi fare."
    } ]
  }, {
    "tStartMs": 291080,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Quindi blog, chat line, video, libro, webinar"
    } ]
  }, {
    "tStartMs": 293390,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "paccone, meeting, scambiare in abbondanza con le persone e fare"
    } ]
  }, {
    "tStartMs": 298190,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "in modo che quando mi presento, questi si sentano così in colpa di tutto quello che"
    } ]
  }, {
    "tStartMs": 302330,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "gli ho dato prima, che vogliono ripagarmi semplicemente mi preferiscono"
    } ]
  }, {
    "tStartMs": 305980,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "solo perché rispetto ai miei competitor, io sembravo babbo natale nel dargli della roba."
    } ]
  }, {
    "tStartMs": 311480,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "E' così. Devo fare in modo di programmare il mio ciclo"
    } ]
  }, {
    "tStartMs": 315170,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "di vendita in questo modo."
    } ]
  } ]
}
